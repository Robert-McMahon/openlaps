      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('200 ms', time) AS \"time\",\n       max(value) FILTER (WHERE channel = 'position.lat')   AS \"latitude\",\n       max(value) FILTER (WHERE channel = 'position.lon')   AS \"longitude\",\n       max(value) FILTER (WHERE channel = 'position.speed') AS \"speed\"\nFROM v_samples_named\nWHERE vehicle_id = '$vehicle'\n  AND channel IN ('position.lat', 'position.lon', 'position.speed')\n  AND $__timeFilter(time)\nGROUP BY 1\nHAVING max(value) FILTER (WHERE channel = 'position.lat') IS NOT NULL\n   AND max(value) FILTER (WHERE channel = 'position.lon') IS NOT NULL\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('200 ms', time) AS \"time\",\n       max(value) FILTER (WHERE channel = 'position.lat')   AS \"latitude\",\n       max(value) FILTER (WHERE channel = 'position.lon')   AS \"longitude\",\n       max(value) FILTER (WHERE channel = 'position.speed') AS \"speed\"\nFROM v_samples_named\nWHERE vehicle_id = '$vehicle'\n  AND channel IN ('position.lat', 'position.lon', 'position.speed')\n  AND $__timeFilter(time)\nGROUP BY 1\nHAVING max(value) FILTER (WHERE channel = 'position.lat') IS NOT NULL\n   AND max(value) FILTER (WHERE channel = 'position.lon') IS NOT NULL\nORDER BY 1 DESC\nLIMIT 1"
        }
      ],
      "timeFrom": "1m",
      "maxDataPoints": 600,
      "description": "Trail and current position. Pivoted to one frame with real latitude/longitude fields -- the geomap locates by field name, which three separate single-value MQTT frames could never provide.",
      "hideTimeOverride": true
    },
