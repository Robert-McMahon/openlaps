# Restarts go2rtc when the camera re-enumerates on USB (camera-watch.sh).
# A user unit: runs as luckfox, who is in the docker group and has lingering
# on, so it needs no root and starts at boot.
# Install on the car, as luckfox:
#   install -D -m 755 camera-watch.sh ~/.local/bin/camera-watch.sh
#   install -D -m 644 camera-watch.service ~/.config/systemd/user/camera-watch.service
#   systemctl --user daemon-reload && systemctl --user enable --now camera-watch
# Log: journalctl --user -u camera-watch
[Unit]
Description=OpenLaps restart go2rtc when the camera re-enumerates

[Service]
ExecStart=%h/.local/bin/camera-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
