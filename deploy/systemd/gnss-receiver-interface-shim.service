[Unit]
Description=openlaps RP2040 GNSS receiver interface to chrony bridge
Documentation=https://github.com/Robert-McMahon/openlaps
After=chrony.service
Requires=chrony.service
PartOf=chrony.service

[Service]
Type=simple
User=openlaps
Group=openlaps
SupplementaryGroups=dialout
EnvironmentFile=-/etc/openlaps/gnss-receiver-interface.env
ExecStart=/usr/bin/python3 /usr/local/libexec/openlaps/gnss_receiver_interface_shim.py $GNSS_RECEIVER_INTERFACE_ARGS
Restart=always
RestartSec=1s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
