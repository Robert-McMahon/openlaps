# Copy to .env (gitignored) and fill in real values. Never commit .env.
# This file is extended as later phases add services; it documents every
# variable those services read at deploy time.

# --- NATS (vehicle + pit) ---
# OPENLAPS_NATS_URL (below) always means *the local server for this stack*:
# the vehicle's server in vehicle-compose.yaml, the pit's in
# pit-compose.yaml. Same variable name, two stacks, one .env each -- do not
# point the pit services at the car.
# The compose stacks mount TLS material as a *directory* and the server
# configs name the files inside it, so NATS_TLS_DIR is the one to fill.
# The three per-file paths below are read by nothing today; they are kept
# for a hand-rolled (non-compose) deployment that wires the files itself.
NATS_TLS_DIR=                     # host dir mounted at /etc/nats/tls (deploy/nats/README.md)
NATS_LEAFNODE_CREDS_PATH=
NATS_TLS_CERT_PATH=
NATS_TLS_KEY_PATH=
NATS_STORE_DIR=                   # vehicle JetStream store; a real dir with room for TELE
NATS_LEAF_PASSWORD=               # vehicle only: leafnode listener authorization
# Pit only: the full leafnode remote URL. It is one variable rather than
# host + password because nats-server expands $VAR only as a whole token,
# never as a substring — pit.conf cannot assemble it from parts. The
# password must equal the vehicle's NATS_LEAF_PASSWORD and the host must
# match its certificate's SAN.
NATS_LEAFNODE_URL=                # e.g. tls://leaf:<password>@192.168.12.176:7422

# --- Pit sourced stream (deploy/provision_pit_streams.py) ---
# TELE_VEHICLE sources the vehicle's TELE across the leafnode and declares
# no subjects of its own -- a subject-declaring copy captures every message
# twice. It is a buffer in front of Timescale, not the archive, so it is
# sized by pit disk rather than by the vehicle's 72 h.
OPENLAPS_PIT_STREAM=TELE_VEHICLE      # name created at the pit
OPENLAPS_VEHICLE_STREAM=TELE          # name sourced from the vehicle
OPENLAPS_PIT_STREAM_MAX_AGE_H=24      # long enough to cover an ingest outage
OPENLAPS_PIT_STREAM_MAX_BYTES=34359738368  # 32 GiB; set from the pit's free disk

# --- Vehicle agent ---
# The profile is the single place a car is described; this env set only
# carries deploy-time wiring (docs/AGENT_DESIGN.md -> Configuration surface).
OPENLAPS_PROFILE=                 # profile directory, e.g. profiles/example-club-racer
OPENLAPS_NATS_URL=nats://127.0.0.1:4222
OPENLAPS_NATS_CREDS=              # optional NATS creds file for the local server
OPENLAPS_VEHICLE_ID=              # optional override of vehicle.yaml's vehicle.id
OPENLAPS_TICK_MS=20               # batching tick, 10-50 ms
OPENLAPS_QUEUE_SIZE=10000         # per-collector bounded queue (samples)
OPENLAPS_PUBLISH_WINDOW=1000      # max unacked JetStream publishes in flight
OPENLAPS_PUBLISH_BUFFER_BYTES=33554432  # publish buffer byte budget before shedding
OPENLAPS_TELE_MAX_AGE_H=72        # TELE stream age cap
OPENLAPS_TELE_MAX_BYTES=8589934592  # TELE stream size cap (vehicle disk budget)
OPENLAPS_REGISTRY_REPUBLISH_S=300 # registry republish interval
OPENLAPS_STATE_DIR=               # optional dir for registry/session state (default: profile dir)

# --- TimescaleDB (pit) ---
# Read by every pit service that touches the database (schema: docs/PIT_SCHEMA.md).
# Set the discrete variables, or TIMESCALE_DSN alone when you need something
# they can't express (sslmode, connect_timeout, a unix socket).
TIMESCALE_HOST=
TIMESCALE_PORT=5432
TIMESCALE_DB=
TIMESCALE_USER=
TIMESCALE_PASSWORD=
TIMESCALE_DSN=                    # optional full libpq connection string; overrides the above

# --- ingest-writer (pit) ---
# Reads OPENLAPS_NATS_URL/_CREDS/_VEHICLE_ID above (pointing at the *pit*
# server) plus TIMESCALE_*. Everything here is write-path tuning; no channel
# names, rates or policies (docs/AGENT_DESIGN.md -> Configuration surface).
OPENLAPS_INGEST_STREAM=TELE_VEHICLE   # pit-side sourced stream to consume (must exist)
OPENLAPS_INGEST_DURABLE=ingest-writer # durable consumer name, and the ingest_cursor key
OPENLAPS_INGEST_BATCH_ROWS=5000       # flush when this many rows are buffered
OPENLAPS_INGEST_FLUSH_MS=200          # ...or this long since the last flush, whichever first
OPENLAPS_INGEST_FETCH_BATCH=500       # messages requested per pull
OPENLAPS_INGEST_MAX_ACK_PENDING=2000  # unacked ceiling; sized to a few fetches
OPENLAPS_INGEST_MAX_BUFFERED_ROWS=200000  # stop pulling past this while a flush is failing
OPENLAPS_INGEST_ACK_WAIT_S=30         # redelivery timer; a flush takes milliseconds
OPENLAPS_INGEST_HEALTH_PORT=8081      # GET /health

# --- live-decoder (pit) ---
# Channel selection and rates live in the mounted YAML, never in env or the
# vehicle profile. The MQTT broker is pit-local and must not cross the radio.
OPENLAPS_LIVE_STREAM=TELE_VEHICLE      # same sourced stream; named, not found by subject
OPENLAPS_LIVE_CONFIG=deploy/pit-config/live-decoder.yaml
OPENLAPS_LIVE_CONFIG_POLL_S=5          # mtime poll; SIGHUP also reloads immediately
OPENLAPS_LIVE_HEALTH_PORT=8082         # GET /health
OPENLAPS_LIVE_MQTT_QUEUE_SIZE=1000     # bounded handoff; full/down means drop live data
OPENLAPS_MQTT_HOST=127.0.0.1
OPENLAPS_MQTT_PORT=1883
OPENLAPS_MQTT_USERNAME=                # optional pit-local broker credentials
OPENLAPS_MQTT_PASSWORD=

# --- timing-extrapolator (pit) ---
# Stateless live derivation from authoritative lap.event crossing timestamps.
# Its two MQTT outputs are explicitly pit-owned and continue between vehicle
# messages; clock-health gating and runaway bounds live in the mounted YAML.
OPENLAPS_TIMING_STREAM=TELE_VEHICLE
OPENLAPS_TIMING_CONFIG=deploy/pit-config/timing-extrapolator.yaml
OPENLAPS_TIMING_HEALTH_PORT=8084

# --- session-control (pit) ---
# Publishes through the leafnode into the vehicle's JetStream domain. Driver
# names, session types and track names live in the mounted roster JSON, not
# in environment. The operator UI (P5.6) is the same server: a browser
# pointed at http://<pit-host>:8080/ gets the page, which asks for the API
# key once and keeps it in that browser only — no separate service, port or
# checked-in credential.
OPENLAPS_VEHICLE_JS_DOMAIN=veh          # vehicle nats-server JetStream domain
OPENLAPS_SESSION_STATE_FILE=/data/session-state.json
OPENLAPS_SESSION_ROSTER=/config/roster.json
OPENLAPS_SESSION_DEFAULT_TRACK=         # optional default when POST omits track_name
OPENLAPS_SESSION_HOST=127.0.0.1         # set explicitly only when exposing on a trusted network
OPENLAPS_SESSION_API_KEY=               # required bearer token when host is not loopback
OPENLAPS_SESSION_PORT=8080              # operator API, browser UI at /, GET /health

# --- Compose wiring (deploy/*-compose.yaml only; no service reads these) ---
# Everything above is read by a service; these are substituted into the
# compose files themselves, so they only matter when deploying with docker.
OPENLAPS_IMAGE=openlaps:local     # shared image tag for all five entry points
OPENLAPS_PROFILE_NAME=example-club-racer  # profile dir under profiles/, vehicle stack
OPENLAPS_SERIAL_DEVICE=/dev/ttyUSB0  # host GPS device passed to the agent container
OPENLAPS_DIALOUT_GID=20           # host gid owning the serial device (`getent group dialout`)
OPENLAPS_ROSTER_FILE=../profiles/example-club-racer/session-roster.json  # mounted read-only
# Video (vehicle stack, `--profile video` only). The stream definitions and
# encoder pipelines live in deploy/go2rtc/go2rtc.yaml, not here.
GO2RTC_IMAGE_TAG=1.9.14-hardware  # pinned; -hardware carries the Intel VAAPI drivers
OPENLAPS_VIDEO_DEVICE=/dev/video0 # host camera passed to the go2rtc container

# --- Grafana (pit) ---
# The pit's read surface. Dashboards and datasources are provisioned from
# deploy/pit-config/grafana/ and are read-only in the browser, so nothing
# here configures *what* Grafana shows -- only how it is reached and what it
# is allowed to read.
GRAFANA_IMAGE_TAG=12.4.9          # pinned; a minor bump can change panel schema
# The MQTT datasource plugin, downloaded at first start. Held at 1.1.0, not
# latest: 1.2.0 added a streaming-key namespace check that rejects every
# live subscription on OSS Grafana 12.4 ("invalid orgId supplied in
# request", grafana/mqtt-datasource#361) -- gauges connect, then show
# "No data". Re-test on the bench before raising either pin.
GRAFANA_MQTT_PLUGIN_VERSION=1.1.0
# Official clock panel: the pit wall's browser-local count-up clocks (lap,
# sector, stint) that tick without a live stream behind them. Same
# discipline as above: exact pin, downloaded at first start.
GRAFANA_CLOCK_PLUGIN_VERSION=3.2.4
# Video panel: embeds the vehicle's go2rtc player in the `video` dashboard.
# Core Grafana cannot render an iframe (text-panel HTML sanitization) or
# play a live MSE/WebRTC stream. Last upstream release 2023; re-test on the
# bench before raising the Grafana pin, not just this one.
GRAFANA_VIDEO_PLUGIN_VERSION=1.0.7
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=           # required; sign-up is disabled, so this is the only way in
GRAFANA_ROOT_URL=http://localhost:3000  # -> GF_SERVER_ROOT_URL; set to the pit host's address
#
# Grafana's OWN database credential. This is a different role from the
# TIMESCALE_USER/TIMESCALE_PASSWORD above and the difference is the point:
# the pit services connect as the owner and write; Grafana connects as a
# role with CONNECT, USAGE and SELECT on the views only, so a query typed
# into the Explore editor cannot reach a base table or delete anything. The
# role is created by migration 002 with this password; the grafana container
# is not given the pit's .env at all, so it cannot see TIMESCALE_PASSWORD
# even by accident.
#
#     Do not set these two to the same values as TIMESCALE_USER/PASSWORD.
#
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=              # required; must differ from TIMESCALE_PASSWORD

# --- ntrip-client (pit only; credentials never touch the vehicle) ---
# Reads OPENLAPS_NATS_URL/_CREDS/_VEHICLE_ID above (pointing at the *pit*
# server). RTCM bytes are published fire-and-forget on core NATS
# (rtcm.<vehicle>, ADR 0006) -- there is nothing to tune about durability
# here because there isn't any.
NTRIP_HOST=
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=
NTRIP_USER=
NTRIP_PASSWORD=
OPENLAPS_NTRIP_STREAM=TELE_VEHICLE  # sourced stream the GGA position feed reads
NTRIP_ENABLE_GGA=0            # send a synthesised $GPGGA upstream (VRS/network-RTK mountpoints)
NTRIP_GGA_INTERVAL_S=10       # how often, when enabled
NTRIP_IDLE_TIMEOUT_S=30       # no bytes from the caster this long -> treat it as dead, redial
OPENLAPS_NTRIP_HEALTH_PORT=8083   # GET /health
