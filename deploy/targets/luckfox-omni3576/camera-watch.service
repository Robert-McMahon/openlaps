# Restarts go2rtc when the camera re-enumerates on USB (camera-watch.sh).
# A user unit: runs as luckfox, who is in the docker group and has lingering
# on, so it needs no root and starts at boot.
# It runs the deployed script and is linked, not copied, so both follow
# tools/deploy_vehicle.sh, which restarts it when the script changes.
# Install once on the car, as luckfox:
#   systemctl --user enable --now /opt/openlaps/deploy/targets/luckfox-omni3576/camera-watch.service
# Log: journalctl --user -u camera-watch
[Unit]
Description=OpenLaps restart go2rtc when the camera re-enumerates

[Service]
ExecStart=/opt/openlaps/deploy/targets/luckfox-omni3576/camera-watch.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
