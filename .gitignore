# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Secrets — never committed; see example.env
.env
*.creds
*.pem
*.key

# Live/private profile data — only the example profile is public. The Phase 4
# bench rig used to be a second profile here; it is `tools/bench-hardware.yaml`
# now, an overlay on this one (ADR 0010).
# (order matters: un-ignore the dir, then its contents)
profiles/*
!profiles/example-club-racer/
!profiles/example-club-racer/**

# Agent runtime state (written beside the profile by default) — must come
# after the profile un-ignore rules above, or those re-include it.
**/.registry-state.json*
**/.session-state.json*
**/.claude

# Bench artefacts (docs/plan/PHASE4.md → ground rules): manifests and summary
# documents under docs/bench/ are checked in; the raw per-sample and per-run
# data they describe is large, local, and named by path in the manifest.
docs/bench/**/*.csv
docs/bench/**/*.csv.gz
docs/bench/**/*.log

# Where docs/BENCH_RUNBOOK.md tells the operator to point link_probe's --out.
# Raw probe CSVs and the manifests written beside them are local run data;
# the copy that gets kept is curated into docs/bench/ afterwards.
/runs/
# OS
.DS_Store
site/
