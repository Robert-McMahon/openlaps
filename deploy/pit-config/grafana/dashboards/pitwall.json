    {
      "id": 1,
      "title": "Race laps completed",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "text": {
          "titleSize": 16,
          "valueSize": 44
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Race laps completed$/",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, count(*) AS \"Race laps completed\" FROM v_laps l WHERE l.vehicle_id = '$vehicle' AND l.session_id = (SELECT session_id FROM v_session_active WHERE vehicle_id = '$vehicle') AND l.crossed_at > (SELECT started FROM v_session_active WHERE vehicle_id = '$vehicle')"
        }
      ],
      "maxDataPoints": 600,
      "description": "Start/finish crossings since the session start set in session control, so formation laps before the start are not counted. Move the start under Edit timeline and this follows."
    },
    {
      "id": 2,
      "title": "Pit extrapolated lap clock",
      "type": "stat",
      "datasource": {
        "type": "grafana-mqtt-datasource",
        "uid": "mqtt-live"
      },
      "gridPos": {
        "x": 4,
