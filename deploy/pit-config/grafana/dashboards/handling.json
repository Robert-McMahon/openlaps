              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              }
            ]
          },
          "unit": "accG"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "hideTimeOverride": true,
      "id": 39,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "12.4.9",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(time, $__interval) AS time,\n       avg(value) FILTER (WHERE channel = 'car.accel_y') AS \"Lateral g\",\n       avg(value) FILTER (WHERE channel = 'car.accel_x') AS \"Longitudinal g\"\nFROM v_samples_named\nWHERE vehicle_id = '$vehicle'\n  AND channel IN ('car.accel_x', 'car.accel_y')\n  AND $__timeFilter(time)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "timeFrom": "5m",
      "title": "Lateral and longitudinal g",
      "type": "timeseries",
      "maxDataPoints": 1000,
      "interval": "1s"
    }
  ]
}
