          "rawQuery": true,
          "rawSql": "SELECT now() AS time, (SELECT concat(floor(min(lap_time_s) / 60)::int, ':', to_char(min(lap_time_s) - 60 * floor(min(lap_time_s) / 60), 'FM00.000')) FROM v_laps WHERE vehicle_id = '$vehicle' AND valid AND pit_status = 'track' AND session_id IS NOT DISTINCT FROM (SELECT session_id FROM v_laps WHERE vehicle_id = '$vehicle' ORDER BY crossed_at DESC LIMIT 1) AND crossed_at > COALESCE((SELECT started FROM v_session_active WHERE vehicle_id = '$vehicle'), '-infinity')) AS \"Best lap\""
