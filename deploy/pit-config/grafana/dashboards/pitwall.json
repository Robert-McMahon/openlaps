        "w": 8,
        "h": 16
      },
      "description": "Newest lap first, for the session the latest lap belongs to. Laps are numbered from the session start set in session control; crossings before it read pre-start. To best is seconds off the fastest valid lap since the start. Once the session has ended every lap is numbered.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
