      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-mqtt-datasource",
            "uid": "mqtt-live"
          },
          "topic": "openlaps/$vehicle/timing.lap_elapsed"
        },
        {
          "refId": "B",
          "datasource": {
