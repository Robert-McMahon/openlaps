# Copy to .env (gitignored) and fill in real values. Never commit .env.
# This file is extended as later phases add services; it documents every
# variable those services read at deploy time.

# --- NATS (vehicle + pit) ---
NATS_LEAFNODE_CREDS_PATH=
NATS_TLS_CERT_PATH=
NATS_TLS_KEY_PATH=

# --- Vehicle agent ---
# The profile is the single place a car is described; this env set only
# carries deploy-time wiring (docs/AGENT_DESIGN.md -> Configuration surface).
OPENLAPS_PROFILE=                 # profile directory, e.g. profiles/example-club-racer
OPENLAPS_NATS_URL=nats://127.0.0.1:4222
OPENLAPS_NATS_CREDS=              # optional NATS creds file for the local server
OPENLAPS_VEHICLE_ID=              # optional override of vehicle.yaml's vehicle.id
OPENLAPS_TICK_MS=20               # batching tick, 10-50 ms
OPENLAPS_QUEUE_SIZE=10000         # per-collector bounded queue (samples)
OPENLAPS_PUBLISH_WINDOW=1000      # max unacked JetStream publishes in flight
OPENLAPS_PUBLISH_BUFFER_BYTES=33554432  # publish buffer byte budget before shedding
OPENLAPS_TELE_MAX_AGE_H=72        # TELE stream age cap
OPENLAPS_TELE_MAX_BYTES=8589934592  # TELE stream size cap (vehicle disk budget)
OPENLAPS_REGISTRY_REPUBLISH_S=300 # registry republish interval
OPENLAPS_STATE_DIR=               # optional dir for registry/session state (default: profile dir)

# --- TimescaleDB (pit) ---
# Read by every pit service that touches the database (schema: docs/PIT_SCHEMA.md).
# Set the discrete variables, or TIMESCALE_DSN alone when you need something
# they can't express (sslmode, connect_timeout, a unix socket).
TIMESCALE_HOST=
TIMESCALE_PORT=5432
TIMESCALE_DB=
TIMESCALE_USER=
TIMESCALE_PASSWORD=
TIMESCALE_DSN=                    # optional full libpq connection string; overrides the above

# --- ingest-writer (pit) ---
# Reads OPENLAPS_NATS_URL/_CREDS/_VEHICLE_ID above (pointing at the *pit*
# server) plus TIMESCALE_*. Everything here is write-path tuning; no channel
# names, rates or policies (docs/AGENT_DESIGN.md -> Configuration surface).
OPENLAPS_INGEST_STREAM=TELE_VEHICLE   # pit-side sourced stream to consume
OPENLAPS_INGEST_DURABLE=ingest-writer # durable consumer name, and the ingest_cursor key
OPENLAPS_INGEST_BATCH_ROWS=5000       # flush when this many rows are buffered
OPENLAPS_INGEST_FLUSH_MS=200          # ...or this long since the last flush, whichever first
OPENLAPS_INGEST_FETCH_BATCH=500       # messages requested per pull
OPENLAPS_INGEST_MAX_ACK_PENDING=2000  # unacked ceiling; sized to a few fetches
OPENLAPS_INGEST_MAX_BUFFERED_ROWS=200000  # stop pulling past this while a flush is failing
OPENLAPS_INGEST_ACK_WAIT_S=30         # redelivery timer; a flush takes milliseconds
OPENLAPS_INGEST_HEALTH_PORT=8081      # GET /health

# --- live-decoder (pit) ---
# Channel selection and rates live in the mounted YAML, never in env or the
# vehicle profile. The MQTT broker is pit-local and must not cross the radio.
OPENLAPS_LIVE_CONFIG=deploy/pit-config/live-decoder.yaml
OPENLAPS_LIVE_CONFIG_POLL_S=5          # mtime poll; SIGHUP also reloads immediately
OPENLAPS_LIVE_HEALTH_PORT=8082         # GET /health
OPENLAPS_LIVE_MQTT_QUEUE_SIZE=1000     # bounded handoff; full/down means drop live data
OPENLAPS_MQTT_HOST=127.0.0.1
OPENLAPS_MQTT_PORT=1883
OPENLAPS_MQTT_USERNAME=                # optional pit-local broker credentials
OPENLAPS_MQTT_PASSWORD=

# --- Grafana (pit) ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- ntrip-client (pit only; credentials never touch the vehicle) ---
# Reads OPENLAPS_NATS_URL/_CREDS/_VEHICLE_ID above (pointing at the *pit*
# server). RTCM bytes are published fire-and-forget on core NATS
# (rtcm.<vehicle>, ADR 0006) -- there is nothing to tune about durability
# here because there isn't any.
NTRIP_HOST=
NTRIP_PORT=2101
NTRIP_MOUNTPOINT=
NTRIP_USER=
NTRIP_PASSWORD=
NTRIP_ENABLE_GGA=0            # send a synthesised $GPGGA upstream (VRS/network-RTK mountpoints)
NTRIP_GGA_INTERVAL_S=10       # how often, when enabled
NTRIP_IDLE_TIMEOUT_S=30       # no bytes from the caster this long -> treat it as dead, redial
OPENLAPS_NTRIP_HEALTH_PORT=8083   # GET /health
