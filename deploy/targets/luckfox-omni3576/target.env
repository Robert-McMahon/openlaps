# Target: Luckfox Omni3576 (Rockchip RK3576, aarch64).
#
# Append to deploy/.env. The overlay documents extra device mappings for a
# host with a current Compose plugin; the shipped Docker 20.10 deployment uses
# systemd and the `docker run` commands in README.md:
#
#     cat deploy/targets/luckfox-omni3576/target.env >> deploy/.env
#     docker compose -f deploy/vehicle-compose.yaml \
#       -f deploy/targets/luckfox-omni3576/compose.yaml --profile video up -d
#
# README.md in this directory is the full wiring and installation document.
# This target supports GPIO PPS with the checked-in device-tree overlay; H.265
# encode remains unsupported.

OPENLAPS_TARGET=luckfox-omni3576

# The GNSS receiver on uart2 (header pins 8/10), which needs the device-tree
# change in openlaps.dtsi. Not /dev/ttyS4: that is this board's Bluetooth HCI
# link, and the stock device tree disables every other UART — see README.md.
# On an unflashed board use a USB-serial adapter and set /dev/ttyUSB0 here.
# Must agree with `serial0.port` in hardware.yaml; tests/test_hardware.py
# fails the pair if it does not.
OPENLAPS_SERIAL_DEVICE=/dev/ttyS2
OPENLAPS_DIALOUT_GID=20

# Video. `-rockchip` is the go2rtc image built against Rockchip MPP: its
# ffmpeg has h264_rkmpp and rkrga and is configured `--disable-vaapi`, which
# is the exact inverse of the `-hardware` image the X4 uses.
GO2RTC_IMAGE_TAG=1.9.14-rockchip
OPENLAPS_VIDEO_DEVICE=/dev/video0

# Cabin audio comes from the board's ES8388 codec through the user session's
# PulseAudio/PipeWire socket, not from ALSA: the -rockchip ffmpeg build has
# no ALSA input device at all (`ffmpeg -devices` lists pulse, oss and
# openal). compose.yaml mounts this path and sets PULSE_SERVER from it.
OPENLAPS_PULSE_SOCKET=/run/user/1000/pulse/native
