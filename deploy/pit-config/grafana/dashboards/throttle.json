{
  "uid": "throttle",
  "title": "Throttle and manifold pressure",
  "description": "Last minute at the stored sample rate: throttle position against accelerator pedal position, beside manifold pressure in psi. The crosshair and tooltip are shared, so hovering one chart reads the other at the same instant.",
  "editable": false,
  "schemaVersion": 42,
  "version": 1,
  "graphTooltip": 2,
  "liveNow": true,
  "refresh": "5s",
  "time": {
    "from": "now-1m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "timezone": "browser",
  "tags": [
    "openlaps",
    "car"
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Session control",
      "tooltip": "Open the session-control operator UI",
      "type": "link",
      "url": "http://localhost:8080/"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "example-club-racer",
          "value": "example-club-racer"
        },
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "definition": "SELECT DISTINCT vehicle_id AS __text, vehicle_id AS __value FROM v_samples_named WHERE $__timeFilter(time) ORDER BY 1",
        "includeAll": false,
        "label": "Vehicle",
        "name": "vehicle",
        "options": [],
        "query": "SELECT DISTINCT vehicle_id AS __text, vehicle_id AS __value FROM v_samples_named WHERE $__timeFilter(time) ORDER BY 1",
        "refresh": 1,
        "regex": "",
        "regexApplyTo": "value",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Throttle position and accelerator pedal position",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 18
      },
      "description": "Drive-by-wire throttle blade against the driver's pedal, both in percent on one axis. Every stored sample, no averaging.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 3,
            "spanNulls": true,
            "axisPlacement": "left"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Throttle position"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Accelerator pedal position"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none",
          "hideZeros": false
        }
      },
      "interval": "1ms",
      "maxDataPoints": 100000,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, max(value) FILTER (WHERE channel = 'car.throttle_pos') AS \"Throttle position\", max(value) FILTER (WHERE channel = 'car.accel_pedal_pos') AS \"Accelerator pedal position\"\nFROM v_samples_named\nWHERE $__timeFilter(time)\n  AND vehicle_id = '$vehicle'\n  AND channel IN ('car.throttle_pos', 'car.accel_pedal_pos')\nGROUP BY time\nORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "title": "Manifold pressure",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 18
      },
      "description": "Manifold pressure in psi gauge (negative is vacuum), converted from the stored kPa absolute against a 101.325 kPa atmosphere. Every stored sample, no averaging.",
      "fieldConfig": {
        "defaults": {
          "unit": "pressurepsi",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "auto",
            "pointSize": 3,
            "spanNulls": true,
            "axisPlacement": "left"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Manifold pressure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "min",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none",
          "hideZeros": false
        }
      },
      "interval": "1ms",
      "maxDataPoints": 100000,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT time, (value - 101.325) * 0.145038 AS \"Manifold pressure\"\nFROM v_samples_named\nWHERE $__timeFilter(time)\n  AND vehicle_id = '$vehicle'\n  AND channel = 'car.map'\nORDER BY time"
        }
      ]
    }
  ]
}
