    {
      "id": 25,
      "title": "Refuel release in",
      "type": "grafana-clock-panel",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 20,
        "y": 32,
        "w": 4,
        "h": 4
      },
      "description": "Counts down in the browser, every second, to the earliest legal release: the PitEntryRefuel crossing plus the race plan's minimum refuelling time (8 min). Read from the refuel line crossings of the last 45 minutes, so it starts when the car crosses the line and does not wait for a lap. Shows RELEASE once the minimum has passed and clears when the car crosses PitExitRefuel.",
      "options": {
        "mode": "countdown",
        "refresh": "sec",
        "clockType": "24 hour",
        "fontMono": true,
        "bgColor": "",
        "countupSettings": {
          "source": "query",
          "queryCalculation": "lastNotNull",
          "queryField": "Stint started",
          "beginCountupTime": "",
          "beginText": "0:00:00",
          "noValueText": "no stint yet",
          "invalidValueText": "invalid timestamp",
          "customFormat": "h:mm:ss"
        },
        "countdownSettings": {
          "source": "query",
          "endCountdownTime": "",
          "queryCalculation": "lastNotNull",
          "queryField": "Release at",
          "endText": "RELEASE",
          "noValueText": "not refuelling",
          "invalidValueText": "not refuelling",
          "customFormat": "m:ss"
        },
        "descriptionSettings": {
          "source": "none",
          "descriptionText": "",
          "queryField": "",
          "noValueText": "",
          "fontSize": "12px",
          "fontWeight": "normal"
        },
        "dateSettings": {
          "showDate": false,
          "dateFormat": "YYYY-MM-DD",
          "locale": "",
          "fontSize": "20px",
          "fontWeight": "normal"
        },
        "timeSettings": {
          "fontSize": "44px",
          "fontWeight": "bold"
        },
        "timezone": "",
        "timezoneSettings": {
          "showTimezone": false,
          "zoneFormat": "offsetAbbv",
          "fontSize": "12px",
          "fontWeight": "normal"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time,\n       (SELECT CASE WHEN e.event ->> 'type' = 'pit_entry'\n                    THEN e.time + make_interval(secs => COALESCE((SELECT rp.refuel_min_s FROM v_session_active a JOIN v_race_plan rp ON rp.session_id = a.session_id WHERE a.vehicle_id = '$vehicle' LIMIT 1), 480))\n               END\n        FROM (SELECT s.time, s.value_text::jsonb AS event\n              FROM v_samples_named s\n              WHERE s.channel = 'lap.event' AND s.vehicle_id = '$vehicle'\n                AND s.value_text IS NOT NULL AND s.time > now() - interval '45 minutes') e\n        WHERE e.event ->> 'type' IN ('pit_entry', 'pit_exit') AND lower(e.event ->> 'line') LIKE '%refuel%'\n        ORDER BY e.time DESC LIMIT 1) AS \"Release at\""
        }
      ]
    }
  ]
}
