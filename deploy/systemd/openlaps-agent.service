# The agent without docker, for an SBC running it directly -- which is what
# the bench does today.
#
#     sudo cp deploy/systemd/openlaps-agent.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now openlaps-agent
#
# This unit assumes the repository is checked out at /opt/openlaps and that
# `uv sync` has been run there. Adjust WorkingDirectory/ExecStart if not.
# `deploy/vehicle-compose.yaml` is the containerised alternative; run one or
# the other, not both -- they would fight over the serial port.

[Unit]
Description=openlaps vehicle telemetry agent
Documentation=https://github.com/Robert-McMahon/openlaps
# nats-server has to be listening before the agent can provision TELE/CMD.
# The agent retries a refused connection with backoff, so this is ordering,
# not a hard requirement -- and the same is true of `openlaps-can.service`,
# which brings the profile's buses up as root because the agent cannot.
After=network-online.target nats-server.service openlaps-can.service
Wants=network-online.target openlaps-can.service

[Service]
Type=exec
User=openlaps
Group=openlaps
# Serial devices are group-owned by dialout; can0 needs nothing beyond the
# interface being up, which openlaps-can.service has done by now.
SupplementaryGroups=dialout

WorkingDirectory=/opt/openlaps
# Carries OPENLAPS_PROFILE, and OPENLAPS_HARDWARE when this box is one of
# the boards in deploy/targets/ -- the profile describes the car, the
# overlay describes the SBC it is bolted to (ADR 0010).
EnvironmentFile=/etc/openlaps/agent.env

# The CAN interface is host state, not the agent's: it configures no bitrate
# and brings no link up. `openlaps-can.service` does that, as root and from
# the same profile, and is ordered before this unit above. There is no
# ExecStartPre here on purpose: one would run as `User=openlaps`, be refused
# CAP_NET_ADMIN every single time, and have that refusal hidden by the `-`
# prefix it needs in order not to block startup.
ExecStart=/opt/openlaps/.venv/bin/openlaps-agent

# The agent handles SIGTERM: it drains its queues and closes the publisher
# cleanly, so let it. 30 s is far longer than a clean stop needs and short
# enough not to hang a reboot.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=5s

# Telemetry capture is the machine's job; let it lose the OOM lottery last.
OOMScoreAdjust=-500

# Hardening. The agent reads a profile, writes its registry/session state to
# OPENLAPS_STATE_DIR, and talks to a local socket -- nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# StateDirectory creates and owns /var/lib/openlaps; point
# OPENLAPS_STATE_DIR at it in agent.env.
StateDirectory=openlaps
ReadWritePaths=/var/lib/openlaps
# Raw serial capture (profile serial `raw_log: true` + OPENLAPS_RAW_CAPTURE_DIR
# in agent.env — docs/RAW_CAPTURE.md): the sandbox must also allow the
# capture root, and it must exist. Uncomment both when enabling it.
#ExecStartPre=+/usr/bin/install -d -o openlaps -g openlaps /mnt/data/captures
#ReadWritePaths=/mnt/data/captures

StandardOutput=journal
StandardError=journal
SyslogIdentifier=openlaps-agent

[Install]
WantedBy=multi-user.target
