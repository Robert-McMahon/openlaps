      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN l.crossed_at > COALESCE(a.started, '-infinity') THEN (count(*) FILTER (WHERE l.crossed_at > COALESCE(a.started, '-infinity')) OVER (PARTITION BY l.session_id ORDER BY l.crossed_at))::text ELSE 'pre-start' END AS \"Lap\",\n       concat(floor(lap_time_s / 60)::int, ':', to_char(lap_time_s - 60 * floor(lap_time_s / 60), 'FM00.000')) AS \"Time\",\n       round((lap_time_s - min(lap_time_s) FILTER (WHERE valid AND l.crossed_at > COALESCE(a.started, '-infinity')) OVER ())::numeric, 3) AS \"To best\",\n       COALESCE(driver, '-') AS \"Driver\",\n       concat_ws(', ', NULLIF(pit_status, 'track'), CASE WHEN NOT valid THEN 'invalid' END) AS \"Note\",\n       l.crossed_at AS time\nFROM v_laps l\nLEFT JOIN v_session_active a ON a.session_id = l.session_id AND a.vehicle_id = l.vehicle_id\nWHERE l.vehicle_id = '$vehicle'\n  AND l.session_id IS NOT DISTINCT FROM (SELECT session_id FROM v_laps WHERE vehicle_id = '$vehicle' ORDER BY crossed_at DESC LIMIT 1)\nORDER BY l.crossed_at DESC\nLIMIT 25"
        }
      ]
