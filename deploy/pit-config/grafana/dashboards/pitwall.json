{
  "uid": "pitwall",
  "title": "Pit wall / live timing",
  "description": "Pit wall / live timing \u2014 provisioned openlaps endurance operations dashboard.",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "openlaps",
    "endurance"
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "vehicle",
        "label": "Vehicle",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "definition": "SELECT vehicle_id AS __text, vehicle_id AS __value FROM (SELECT DISTINCT vehicle_id FROM v_samples_named WHERE $__timeFilter(time) UNION SELECT current_setting('openlaps.vehicle_id', true)) v WHERE vehicle_id IS NOT NULL ORDER BY (vehicle_id = current_setting('openlaps.vehicle_id', true)) DESC NULLS LAST, 1",
        "query": "SELECT vehicle_id AS __text, vehicle_id AS __value FROM (SELECT DISTINCT vehicle_id FROM v_samples_named WHERE $__timeFilter(time) UNION SELECT current_setting('openlaps.vehicle_id', true)) v WHERE vehicle_id IS NOT NULL ORDER BY (vehicle_id = current_setting('openlaps.vehicle_id', true)) DESC NULLS LAST, 1",
        "refresh": 1,
        "options": [],
        "includeAll": false,
        "sort": 0,
        "current": {},
        "description": "Opens on the vehicle this pit is deployed for (OPENLAPS_VEHICLE_ID); any other vehicle with data in the time range can be picked."
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "definition": "SELECT DISTINCT COALESCE(concat(left(session_id::text, 13), ' UTC ', session_type, ' at ', COALESCE(NULLIF(track_name, ''), 'unknown track')), 'unattributed') AS __text, COALESCE(session_id::text, 'unattributed') AS __value FROM v_laps WHERE vehicle_id = '$vehicle' AND $__timeFilter(crossed_at) ORDER BY 1",
        "query": "SELECT DISTINCT COALESCE(concat(left(session_id::text, 13), ' UTC ', session_type, ' at ', COALESCE(NULLIF(track_name, ''), 'unknown track')), 'unattributed') AS __text, COALESCE(session_id::text, 'unattributed') AS __value FROM v_laps WHERE vehicle_id = '$vehicle' AND $__timeFilter(crossed_at) ORDER BY 1",
        "refresh": 1,
        "options": [],
        "includeAll": true,
        "sort": 1,
        "allValue": "all",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "driver",
        "label": "Driver",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "definition": "SELECT DISTINCT driver AS __text, driver AS __value FROM v_laps WHERE vehicle_id = '$vehicle' AND driver IS NOT NULL AND ('$session' = 'all' OR session_id::text = '$session') AND $__timeFilter(crossed_at) ORDER BY 1",
        "query": "SELECT DISTINCT driver AS __text, driver AS __value FROM v_laps WHERE vehicle_id = '$vehicle' AND driver IS NOT NULL AND ('$session' = 'all' OR session_id::text = '$session') AND $__timeFilter(crossed_at) ORDER BY 1",
        "refresh": 1,
        "options": [],
        "includeAll": true,
        "sort": 1,
        "allValue": "all",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "stint",
        "label": "Stint",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "definition": "SELECT DISTINCT concat('Stint ', stint_number, ' \u2014 ', COALESCE(driver, 'unattributed')) AS __text, stint_number::text AS __value FROM v_laps WHERE '$session' <> 'all' AND session_id::text = '$session' AND stint_number IS NOT NULL ORDER BY 1",
        "query": "SELECT DISTINCT concat('Stint ', stint_number, ' \u2014 ', COALESCE(driver, 'unattributed')) AS __text, stint_number::text AS __value FROM v_laps WHERE '$session' <> 'all' AND session_id::text = '$session' AND stint_number IS NOT NULL ORDER BY 1",
        "refresh": 1,
        "options": [],
        "includeAll": true,
        "sort": 1,
        "allValue": "all",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "lap",
        "label": "Lap",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "timescale"
        },
        "definition": "SELECT concat('Lap ', lap_number, ' \u2014 ', COALESCE(driver, 'unattributed'), ' \u2014 ', to_char(crossed_at, 'YYYY-MM-DD HH24:MI:SS')) AS __text, lap_id::text AS __value FROM v_laps WHERE vehicle_id = '$vehicle' AND ('$session' = 'all' OR session_id::text = '$session') AND ('$driver' = 'all' OR driver = '$driver') AND $__timeFilter(crossed_at) ORDER BY crossed_at",
        "query": "SELECT concat('Lap ', lap_number, ' \u2014 ', COALESCE(driver, 'unattributed'), ' \u2014 ', to_char(crossed_at, 'YYYY-MM-DD HH24:MI:SS')) AS __text, lap_id::text AS __value FROM v_laps WHERE vehicle_id = '$vehicle' AND ('$session' = 'all' OR session_id::text = '$session') AND ('$driver' = 'all' OR driver = '$driver') AND $__timeFilter(crossed_at) ORDER BY crossed_at",
        "refresh": 1,
        "options": [],
        "includeAll": true,
        "sort": 1,
        "allValue": "all",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
