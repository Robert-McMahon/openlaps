# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Secrets — never committed; see example.env
.env
*.creds
*.pem
*.key

# Live/private profile data — only the example profile is public.
# (order matters: un-ignore the dir, then its contents)
profiles/*
!profiles/example-club-racer/
!profiles/example-club-racer/**

# Agent runtime state (written beside the profile by default) — must come
# after the profile un-ignore rules above, or those re-include it.
**/.registry-state.json*
**/.session-state.json*
**/.claude

# Bench artefacts (docs/plan/PHASE4.md → ground rules): manifests and summary
# documents under docs/bench/ are checked in; the raw per-sample and per-run
# data they describe is large, local, and named by path in the manifest.
docs/bench/**/*.csv
docs/bench/**/*.csv.gz
docs/bench/**/*.log
# OS
.DS_Store
