# Remote ECU access over USB/IP -- docs/operations/remote-ecu.md.
#
# Install the same file on BOTH ends:
#
#     sudo install -m 0644 deploy/ecu/openlaps-ecu.env /etc/default/openlaps-ecu
#
# and fill the IDs from the vehicle, with the ECU powered and plugged in:
#
#     lsusb        # e.g. "Bus 003 Device 004: ID xxxx:yyyy Haltech ..."
#

# 4 hex digits each, no 0x.
OPENLAPS_ECU_USB_VID=
OPENLAPS_ECU_USB_PID=

# Pit only: the vehicle SBC on the car LAN.
OPENLAPS_ECU_HOST=192.168.12.222

# Loop period for both ends, seconds.
OPENLAPS_ECU_POLL_S=3

# Pit only: the Windows guest's container (omarchy-windows, or ecu-windows
# from deploy/pit-compose.yaml) and the TCP port QEMU listens on inside it
# for the usbredir stream. 4100-4159 belong to the desktop windows-usb tool.
OPENLAPS_ECU_VM=omarchy-windows
OPENLAPS_ECU_VM_PORT=4160
