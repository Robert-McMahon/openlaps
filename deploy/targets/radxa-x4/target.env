# Target: Radxa X4 (Intel N100) — the board the vehicle stack was written on.
#
# Append to deploy/.env. Every value here is also the default compiled into
# deploy/vehicle-compose.yaml, so this file changes nothing on an X4; it
# exists so the defaults are stated somewhere that names the board they
# belong to, rather than only inside a compose expression.
#
#     cat deploy/targets/radxa-x4/target.env >> deploy/.env

# Selects this directory. The compose stack derives the agent's hardware
# overlay (/app/targets/<target>/hardware.yaml) and go2rtc's config from it.
OPENLAPS_TARGET=radxa-x4

# GNSS data, relayed by the onboard RP2040 over USB CDC (ADR 0009). The
# GNSS receiver interface's own output is a separate path on /dev/ttyS4 and is read by
# the chrony shim, not by the agent. This must agree with `serial0.port` in
# hardware.yaml — compose maps the device node, the agent opens it, and
# tests/test_hardware.py fails the pair if they disagree.
OPENLAPS_SERIAL_DEVICE=/dev/ttyACM0
OPENLAPS_DIALOUT_GID=20

# Video. `-hardware` carries the Intel VAAPI drivers the pipelines in
# go2rtc.yaml name; the plain image would fall back to CPU encode on an SBC
# that is also running the agent.
GO2RTC_IMAGE_TAG=1.9.14-hardware
OPENLAPS_VIDEO_DEVICE=/dev/video0
