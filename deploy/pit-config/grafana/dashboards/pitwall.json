    {
      "id": 4,
      "title": "Last / best lap",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescale"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 5,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "text": {
          "titleSize": 16,
          "valueSize": 44
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^(Last lap|Best lap)$/",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescale"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT now() AS time, (SELECT concat(floor(lap_time_s / 60)::int, ':', to_char(lap_time_s - 60 * floor(lap_time_s / 60), 'FM00.000')) FROM v_laps WHERE vehicle_id = '$vehicle' ORDER BY crossed_at DESC LIMIT 1) AS \"Last lap\", (SELECT concat(floor(min(lap_time_s) / 60)::int, ':', to_char(min(lap_time_s) - 60 * floor(min(lap_time_s) / 60), 'FM00.000')) FROM v_laps WHERE vehicle_id = '$vehicle' AND valid AND pit_status = 'track' AND session_id IS NOT DISTINCT FROM (SELECT session_id FROM v_laps WHERE vehicle_id = '$vehicle' ORDER BY crossed_at DESC LIMIT 1) AND crossed_at > COALESCE((SELECT started FROM v_session_active WHERE vehicle_id = '$vehicle'), '-infinity')) AS \"Best lap\""
        }
      ],
      "description": "The most recent completed lap, and the fastest clean lap of its session since the race start. Read from the stored laps, to 0.001 s."
    },
