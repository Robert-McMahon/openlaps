# Copy to .env (gitignored) and fill in real values. Never commit .env.
# This file is extended as later phases add services; it documents every
# variable those services read at deploy time.

# --- NATS (vehicle + pit) ---
NATS_LEAFNODE_CREDS_PATH=
NATS_TLS_CERT_PATH=
NATS_TLS_KEY_PATH=

# --- TimescaleDB (pit) ---
TIMESCALE_HOST=
TIMESCALE_PORT=5432
TIMESCALE_DB=
TIMESCALE_USER=
TIMESCALE_PASSWORD=

# --- Grafana (pit) ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- NTRIP (pit ntrip-client only; never on the vehicle) ---
NTRIP_HOST=
NTRIP_PORT=
NTRIP_MOUNTPOINT=
NTRIP_USER=
NTRIP_PASSWORD=
