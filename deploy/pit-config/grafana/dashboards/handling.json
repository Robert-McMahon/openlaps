            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "value 1": "Lateral g",
              "value 2": "Longitudinal g"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
