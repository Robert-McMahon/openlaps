      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "display"
              ]
            }
          }
        }
      ],
      "timeFrom": "1m",
      "maxDataPoints": 600,
      "description": "Authoritative vehicle elapsed beside the pit-side extrapolated clock, which keeps counting through a radio dropout and corrects at the next crossing. Running clocks read in tenths (m:ss.t); the value announced at a crossing is definitive and shows milliseconds. A gated pit clock shows \u2014 instead of holding a stale number.",
      "hideTimeOverride": true
    },
